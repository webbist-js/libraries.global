{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "globalEnv": [
    "APP_PUBLIC_URL",
    "STRAPI_URL",
    "STRAPI_REST_READONLY_API_KEY",
    "STRAPI_UPLOAD_API_KEY",
    "NEXT_OUTPUT",
    "WEBPACK_CACHE_TYPE",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING",
    "CI",
    "MOBILE_VIEWPORTS_TESTING_ENABLED",
    "BASE_URL",
    "ADMIN_PANEL_CONFIG_API_AUTH_TOKEN",
    "APP_BRAND",
    "APP_URL",
    "CLIENT_ACCOUNT_ACTIVATION_URL",
    "STRAPI_TELEMETRY_DISABLED",
    "RUNNER_TEMP",
    "DEBUG_STATIC_PARAMS_GENERATION",
    "DEBUG_STRAPI_CLIENT_API_CALLS",
    "SHOW_NON_BLOCKING_ERRORS",
    "STRAPI_REST_CUSTOM_API_KEY",
    "STRAPI_PREVIEW_SECRET",
    "STRAPI_BRIDGE_SECRET",
    "BETTER_AUTH_SECRET",
    "RECAPTCHA_SECRET_KEY",
    "NODE_ENV",
    "APP_ENV",
    "NEXT_RUNTIME",
    "BASIC_AUTH_ENABLED",
    "BASIC_AUTH_USERNAME",
    "BASIC_AUTH_PASSWORD",
    "CHANGE_RECORDS_ENABLED",
    "MODERATORS_EMAIL",
    "EVENTBRITE_CLIENT_ID",
    "MOBILE_LIVE_ENABLED",
    "MOBILE_ROUTING_URL",
    "MOBILE_LIVE_STEPUP_SECRET",
    "ATLAS_PROVIDER",
    "ATLAS_ROLLOUT_PERCENT",
    "ATLAS_GEOMETRY_MODE",
    "ATLAS_LEGACY_SOURCE_ENABLED",
    "ATLAS_QUERY_ENABLED",
    "ATLAS_ENABLED",
    "ATLAS_CANONICAL_LOCALE",
    "ATLAS_CURSOR_SECRET",
    "ATLAS_DATABASE_URL",
    "ATLAS_SERVICE_TOKEN",
    "ATLAS_WORKER_PORT",
    "ATLAS_WORKER_HOST",
    "ATLAS_BUILD_ENABLED",
    "ATLAS_SCRATCH_DIR",
    "ATLAS_DETAIL_ZOOM",
    "ATLAS_PUBLIC_BASE_URL",
    "ATLAS_R2_BUCKET",
    "ATLAS_R2_ENDPOINT",
    "ATLAS_UI_ORIGIN",
    "ATLAS_VALIDATOR_PATH",
    "MEILI_ATLAS_HOST",
    "MEILI_ATLAS_SEARCH_KEY",
    "MEILI_ATLAS_KEY",
    "POPULATION_SYNC_ENABLED",
    "BETA_GATE_ENABLED",
    "BETA_PASSWORD",
    "BETA_ACCESS_SECRET",
    "BETA_ACCESS_VERSION",
    "BETA_CONTACT_EMAIL",
    "BETA_SOURCE_URL",
    "BETA_E2E_PASSWORD",
    "MEILISEARCH_HOST",
    "MEILISEARCH_SEARCH_API_KEY",
    "DATABASE_URL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_SECURE",
    "EMAIL_FROM",
    "EMAIL_POSTAL_ADDRESS",
    "EMAIL_REPLY_TO",
    "MAILTRAP_USER",
    "MAILTRAP_PASS",
    "MAILTRAP_HOST",
    "MAILTRAP_PORT",
    "MAILGUN_SMTP_USER",
    "MAILGUN_SMTP_PASS",
    "MAILGUN_SMTP_HOST",
    "MAILGUN_API_KEY",
    "MAILGUN_DOMAIN",
    "NEXT_DIST_DIR",
    "EMAIL_LINK_SECRET",
    "EMAIL_DIGEST_ENABLED",
    "EMAIL_REPORT_ENABLED",
    "EMAIL_SEND_INTERVAL_MS",
    "APP_INTERNAL_URL",
    "CRON_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/**"]
    },
    "build:static": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/**",
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "sync-types": {
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "@repo/shared-data#build",
        "@repo/design-system#build",
        "@repo/events-crypto#build",
        "@repo/access#build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "axe-test": {
      "cache": false,
      "persistent": false
    },
    "playwright-interactive-mode": {
      "cache": false,
      "persistent": false
    },
    "playwright-e2e-tests": {
      "cache": false,
      "persistent": false
    },
    "playwright-seo-tests": {
      "cache": false,
      "persistent": false
    },
    "lhci-perfo-check": {
      "cache": false,
      "persistent": false
    },
    "playwright-visual-tests": {
      "cache": false,
      "persistent": false
    },
    "dev:atlas": {
      "dependsOn": ["@repo/shared-data#build"],
      "cache": false,
      "persistent": true
    }
  },
  "ui": "tui"
}
