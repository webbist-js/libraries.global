# Base URL of the application
# Example:
# - Local development: http://localhost:3000
# - Development: https://dev.example.com
# - Staging: https://staging.example.com
# - Production: https://www.example.com
BASE_URL=http://localhost:3000
# Enable testing against mobile viewports (true / false)
MOBILE_VIEWPORTS_TESTING_ENABLED=false
# Access role-matrix E2E (local only; `pnpm seed:access`)
STRAPI_URL=
# Strapi read-only API token, created by hand in the local admin. The seed
# only reads over REST (libraries, user-profiles); writes go through the
# Document Service, never this token.
STRAPI_SEED_TOKEN=
# Same value as STRAPI_BRIDGE_SECRET in apps/strapi/.env (reads seeded profiles).
STRAPI_BRIDGE_SECRET=
# Better Auth Postgres database (flips emailVerified for fixture users)
BA_DATABASE_URL=
# Password for the access-*@example.test fixture users. No default: generate
# one (e.g. `openssl rand -base64 24`). Re-running the seed resets existing
# fixture users to this value.
ACCESS_FIXTURE_PASSWORD=
# Optional absolute path to the isolated local CMS .env used by the writer.
# Omit to use apps/strapi/.env. The resolved database must still be local.
ACCESS_STRAPI_ENV_PATH=
# Optional: wiki-article slug used for the docs.directEdit gate check
ACCESS_DOC_SLUG=
# Public .ics address for the event feeds spec (e2e/access/event-feeds.spec.ts).
# safeFetch blocks loopback addresses, so Strapi's connection test needs a
# real public URL; host the content of fixtures/feeds/library-events.ics
# somewhere public and point this at it. Unset: the spec is skipped.
EVENT_FEED_TEST_ICS_URL=

# Optional local-only Strapi visual/accessibility project. Use disposable fixture accounts.
QA_STRAPI_URL=http://127.0.0.1:1337
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_READONLY_EMAIL=
QA_READONLY_PASSWORD=
# Confirms that both the audit database and search service are disposable.
QA_AUDIT_ISOLATED_SERVICES=
# Optional port for a separate smoke fallback server (default 3101).
QA_SMOKE_PORT=
