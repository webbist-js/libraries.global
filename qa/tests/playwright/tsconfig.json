{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "dom"],
    "sourceMap": false,
    "types": ["@playwright/test", "node"],
    "baseUrl": "./",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
