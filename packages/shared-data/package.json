{
  "name": "@repo/shared-data",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./atlas-population": {
      "types": "./dist/atlas/population-geography.d.ts",
      "import": "./dist/atlas/population-geography.js",
      "require": "./dist/atlas/population-geography.js"
    },
    "./atlas-local": {
      "types": "./dist/atlas/local-boundaries.d.ts",
      "import": "./dist/atlas/local-boundaries.js",
      "require": "./dist/atlas/local-boundaries.js"
    },
    "./preview-ticket": {
      "types": "./dist/preview-ticket.d.ts",
      "import": "./dist/preview-ticket.js",
      "require": "./dist/preview-ticket.js"
    },
    "./service-key": {
      "types": "./dist/service-key.d.ts",
      "import": "./dist/service-key.js",
      "require": "./dist/service-key.js"
    },
    "./email-ownership-proof": {
      "types": "./dist/email-ownership-proof.d.ts",
      "import": "./dist/email-ownership-proof.js",
      "require": "./dist/email-ownership-proof.js"
    },
    "./live-proof": {
      "types": "./dist/live-proof.d.ts",
      "import": "./dist/live-proof.js",
      "require": "./dist/live-proof.js"
    },
    "./auth-policy": {
      "types": "./dist/auth-policy.d.ts",
      "import": "./dist/auth-policy.js",
      "require": "./dist/auth-policy.js"
    },
    "./mobile-confirmation": {
      "types": "./dist/mobile-confirmation.d.ts",
      "import": "./dist/mobile-confirmation.js",
      "require": "./dist/mobile-confirmation.js"
    },
    "./mobile-auth": {
      "types": "./dist/mobile-auth.d.ts",
      "default": "./dist/mobile-auth.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "atlas-population": [
        "dist/atlas/population-geography.d.ts"
      ],
      "atlas-local": [
        "dist/atlas/local-boundaries.d.ts"
      ],
      "preview-ticket": [
        "dist/preview-ticket.d.ts"
      ],
      "service-key": [
        "dist/service-key.d.ts"
      ],
      "email-ownership-proof": [
        "dist/email-ownership-proof.d.ts"
      ],
      "live-proof": [
        "dist/live-proof.d.ts"
      ],
      "auth-policy": [
        "dist/auth-policy.d.ts"
      ],
      "mobile-confirmation": [
        "dist/mobile-confirmation.d.ts"
      ],
      "mobile-auth": [
        "dist/mobile-auth.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
