{
  "name": "@repo/sync-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "atlas:backfill": "tsx src/atlas/index.ts --backfill",
    "atlas:build": "tsx src/atlas/build.ts",
    "atlas:population": "tsx src/atlas/prepare-population.ts",
    "atlas:rebuild": "tsx src/atlas/index.ts --rebuild",
    "atlas:reconcile": "tsx src/atlas/index.ts --reconcile",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:atlas": "tsx src/atlas/index.ts",
    "start": "node dist/index.js",
    "start:atlas": "node dist/atlas/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "atlas:population:ingest": "tsx src/atlas/ingest-population.ts",
    "atlas:local-geography": "tsx src/atlas/prepare-local-geography.ts",
    "atlas:population:local": "tsx src/atlas/ingest-population.ts --local"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@repo/event-providers": "workspace:*",
    "@repo/events-crypto": "workspace:*",
    "@repo/shared-data": "workspace:*",
    "dotenv": "17.2.3",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "p-limit": "^6.1.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.11"
  }
}
