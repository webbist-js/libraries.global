DATABASE_URL=postgresql://user:pass@localhost:5432/libraries_global

# AES-256-GCM key (64-char hex) that seals Event Credential values. Must match
# Strapi's EVENTS_CREDENTIAL_KEY: both read the same encrypted rows.
EVENTS_CREDENTIAL_KEY=<64-char hex string>
# The previous key, kept during a rotation so old values still decrypt. Clear
# it once `pnpm --filter @repo/strapi events:rekey` has re-encrypted everything.
EVENTS_CREDENTIAL_KEY_PREV=
# Cron schedule for the full sync run. Default: every 6 hours.
EVENTS_SYNC_CRON=0 */6 * * *
# How many Event Feeds the worker syncs at once.
EVENTS_SYNC_CONCURRENCY=50
# Consecutive failed syncs before the worker pauses an Event Feed itself
# (pausedReason: sync_failures); Strapi's cron then emails its claimants.
EVENTS_AUTOPAUSE_AFTER=4
# Port for the worker's tiny HTTP server (GET /health only).
WORKER_PORT=3100

# Bind address for the health server. Keep 127.0.0.1 unless Strapi is on another host.
WORKER_HOST=127.0.0.1

# Independent Atlas process: pnpm dev:atlas or pnpm atlas:backfill.
# Apply the owned-table migration and enable capture in Strapi before backfill.
ATLAS_ENABLED=false
ATLAS_CANONICAL_LOCALE=en
# Separate DB role: access ONLY the five owned Atlas tables and their sequences.
ATLAS_DATABASE_URL=postgresql://atlas_worker:pass@localhost:5432/libraries_global
STRAPI_URL=http://localhost:1337
STRAPI_BRIDGE_SECRET=
ATLAS_SERVICE_TOKEN=
MEILI_HOST=http://localhost:7701
# Private task/document/settings key for atlas-library and its staging indexes.
MEILI_ATLAS_KEY=
ATLAS_WORKER_PORT=3101
ATLAS_WORKER_HOST=127.0.0.1

# Separate Linux archive job, opt-in only. Never run in the CMS/event process.
ATLAS_BUILD_ENABLED=false
ATLAS_DETAIL_ZOOM=
ATLAS_SCRATCH_DIR=
ATLAS_PUBLIC_BASE_URL=
ATLAS_UI_ORIGIN=https://libraries.global
ATLAS_R2_ENDPOINT=
ATLAS_R2_BUCKET=
ATLAS_VALIDATOR_PATH=../../qa/benchmarks/atlas/validate_archive.py
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Private Reach service. Run dist/atlas/analysis-worker.js separately from the projection worker.
ANALYSIS_SERVICE_URL=http://127.0.0.1:3102
ANALYSIS_SERVICE_TOKEN=replace-with-at-least-32-random-characters
ANALYSIS_WORKER_HOST=127.0.0.1
ANALYSIS_WORKER_PORT=3103
