DATABASE_URL=postgresql://user:pass@localhost:5432/libraries_global

# AES-256-GCM key (64-char hex) that seals Event Credential values. Must match
# Strapi's EVENTS_CREDENTIAL_KEY: both read the same encrypted rows.
EVENTS_CREDENTIAL_KEY=<64-char hex string>
# The previous key, kept during a rotation so old values still decrypt. Clear
# it once `pnpm --filter @repo/strapi events:rekey` has re-encrypted everything.
EVENTS_CREDENTIAL_KEY_PREV=
# Cron schedule for the full sync run. Default: every 6 hours.
EVENTS_SYNC_CRON=0 */6 * * *
# How many Event Feeds the worker syncs at once.
EVENTS_SYNC_CONCURRENCY=50
# Consecutive failed syncs before the worker pauses an Event Feed itself
# (pausedReason: sync_failures); Strapi's cron then emails its claimants.
EVENTS_AUTOPAUSE_AFTER=4
# Port for the worker's tiny HTTP server (GET /health only).
WORKER_PORT=3100

# Bind address for the health server. Keep 127.0.0.1 unless Strapi is on another host.
WORKER_HOST=127.0.0.1
