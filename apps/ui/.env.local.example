# copy&rename to .env.local

# Do not leave empty values, e.g. `NEXT_OUTPUT=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# -------------------------- Next.js settings ---------------------------------

# See next.config.js's "output" option. Possible values:
# - "standalone" - docker container
# - "export" - static export
# - undefined - default, `next start`
NEXT_OUTPUT=standalone

# Enable logging of generateStaticParams output during build time by segment
# DEBUG_STATIC_PARAMS_GENERATION=true

# Enable showing of non-blocking errors in the UI (very chattery logs)
# SHOW_NON_BLOCKING_ERRORS=true

# Enable logging of Strapi Client API calls (very chattery logs)
# DEBUG_STRAPI_CLIENT_API_CALLS=true

# -------------------------- BetterAuth settings ---------------------------------

# Account sessions are independent of the beta browser pass.
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strapi

# -------------------------- Closed beta ----------------------------------

# Enable on BOTH Next.js and Strapi. This requires a server deployment.
BETA_GATE_ENABLED=false
# Server-only shared invitation password. Never prefix these with NEXT_PUBLIC_.
BETA_PASSWORD=
# Generate a separate secret with: openssl rand -hex 32
BETA_ACCESS_SECRET=
# Increment to revoke all browser passes; password/secret changes revoke them too.
BETA_ACCESS_VERSION=1
BETA_CONTACT_EMAIL=hello@libraries.global
BETA_SOURCE_URL=https://github.com/webbist-js/libraries.global
# Deployment and outreach steps: docs/beta-release-setup.md

# -------------------------- BE settings ---------------------------------

# Server-side URL of Strapi (used by SSR/RSC for getSessionSSR and API calls)
STRAPI_URL=http://127.0.0.1:1337

# Public CMS URL for media. Account authentication uses Next.js /api/auth.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Shared secret for server-to-server calls to Strapi (X-Service-Secret: the session
# bridge, moderation and submissions). Must match STRAPI_BRIDGE_SECRET in apps/strapi/.env.
STRAPI_BRIDGE_SECRET=

# Read Only API KEY generated within Strapi, providing access to find and findOne endpoints
STRAPI_REST_READONLY_API_KEY=

# API KEY with custom permissions, providing different access to Strapi endpoints
STRAPI_REST_CUSTOM_API_KEY=

# Strapi API token with ONLY upload.create permission (Settings → API Tokens → Custom)
STRAPI_UPLOAD_API_KEY=

# -------------------------- Sentry settings ---------------------------------

# Sentry DSN
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token
# SENTRY_AUTH_TOKEN=

# Sentry organization
# SENTRY_ORG=

# Sentry project
# SENTRY_PROJECT=

SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# -------------------------- ReCAPTCHA v3 ---------------------------------

# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# RECAPTCHA_SECRET_KEY=

# -------------------------- Basic Auth ---------------------------------

# Enable HTTP Basic Authentication (e.g. for staging environments)
# BASIC_AUTH_ENABLED=true
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# -------------------------- Meilisearch ---------------------------------

# Server-side URL of Meilisearch. Browser searches use /api/search.
MEILISEARCH_HOST=http://localhost:7700

# Private search-only key, scoped to the platform's search indexes.
# Rotate any previously deployed NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY.
MEILISEARCH_SEARCH_API_KEY=

# -------------------------- App settings ---------------------------------

# canonical URL of site - base URL of the frontend application
# (it is used to navigate, generate sitemap URLs, canonical SEO tags etc.)
APP_PUBLIC_URL=http://localhost:3000

# Components and functions that are not *marked as used* will log a warning to the console during development by default.
# To change this behavior, set this env var to `true`.
# NEXT_PUBLIC_PREVENT_UNUSED_FUNCTIONS_ERROR_LOGS=true

# Strapi Preview Shared Secret
STRAPI_PREVIEW_SECRET=your-secret-key

# -------------------------- Email ---------------------------------------

# Transactional mail (sign-in links, password resets, email verification).
# Without these, sign-in emails fail in production; development logs the links instead.
# Setup and testing: docs/email-setup.md

# Generic SMTP (e.g. Brevo). Takes priority over Mailtrap/Mailgun when set.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Public postal address for optional email footers.
# EMAIL_POSTAL_ADDRESS=
# EMAIL_FROM="Libraries Global <info@libraries.global>"
# EMAIL_REPLY_TO=info@libraries.global

# Local testing: a Mailtrap sandbox inbox catches every email (SMTP credentials
# from the inbox's Integration tab, not the API token). Checked before Mailgun.
# MAILTRAP_USER=
# MAILTRAP_PASS=
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525

# Production: Mailgun SMTP credentials for the sending domain
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASS=
# EU-region Mailgun domains must use smtp.eu.mailgun.org
MAILGUN_SMTP_HOST=smtp.mailgun.org

# -------------------------- Scheduled jobs ------------------------------

# Vercel Cron sends this as a bearer token to /api/cron/retention, which
# deletes expired sessions, verification tokens and 30-day-old rate-limit rows.
CRON_SECRET=

# -------------------------- Images ---------------------------------------

# Extra hosts next/image may load from (comma-separated), besides STRAPI_URL and
# NEXT_PUBLIC_STRAPI_URL. Wildcards are not accepted.
# IMAGE_REMOTE_HOSTS=cdn.libraries.global

# -------------------------- Cache revalidation --------------------------

# Strapi webhook secret: POST /api/revalidate with header X-Revalidate-Secret
# purges the fetch cache for the changed entry (see app/api/revalidate).
REVALIDATE_SECRET=

# -------------------------- Mobile libraries: live sharing ---------------

# Signs the "Confirm it's you" step-up cookie for the /live console; must match
# MOBILE_LIVE_STEPUP_SECRET in apps/strapi/.env. Unset, both apps fall back to
# STRAPI_BRIDGE_SECRET. The MOBILE_LIVE_ENABLED off switch lives in Strapi's env.
# MOBILE_LIVE_STEPUP_SECRET=

# -------------------------- Staff area: Traffic --------------------------

# Traffic reports remain unavailable until a real provider is connected.
# Provider feasibility and required metrics: docs/staff-ui-review.md

# -------------------------- Event feeds ----------------------------------

# Eventbrite OAuth app id for "Connect with Eventbrite" on a library's event
# feed. Must match the app registered for EVENTBRITE_CLIENT_ID/SECRET in
# apps/strapi/.env, whose redirect URI is
# <APP_PUBLIC_URL>/api/contribute/event-feeds/eventbrite/callback. Without
# it, the start route answers 503 and the connect form falls back to a
# pasted token.
EVENTBRITE_CLIENT_ID=

# OSRM-compatible driving routing host for public mobile-library stops.
# Defaults to https://router.project-osrm.org for local development.
# Configure your own OSRM service/provider for production traffic.
MOBILE_ROUTING_URL=https://router.project-osrm.org

# Bounded Atlas gateway. Capture/indexing readiness is separate from UI rollout.
ATLAS_QUERY_ENABLED=false
# Switches map, controls, search, list, selection and export together.
# Keep legacy until projection/index readiness has been verified.
ATLAS_PROVIDER=legacy
# Stable anonymous cohort, independent of map-layer/export entitlements.
ATLAS_ROLLOUT_PERCENT=100
# Permanent bounded-query fallback; keep the scalable provider after cutover.
ATLAS_GEOMETRY_MODE=tiles
ATLAS_SERVICE_TOKEN=
MEILI_ATLAS_HOST=http://localhost:7701
MEILI_ATLAS_SEARCH_KEY=
ATLAS_CURSOR_SECRET=

# Verify SMTP and send an explicit test: pnpm --filter @repo/ui email:check --to you@example.org
# Use --suite for all labeled template samples; --preview-dir generates HTML/text without SMTP.
# Never expose SMTP secrets via NEXT_PUBLIC_.
