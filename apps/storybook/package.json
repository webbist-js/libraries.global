{
  "name": "@repo/storybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 storybook build --output-dir dist --disable-telemetry && node --max-old-space-size=2048 scripts/inventory.mjs --check --check-build",
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 storybook dev --port 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "inventory": "node --max-old-space-size=2048 scripts/inventory.mjs && node --max-old-space-size=2048 scripts/component-coverage.mjs",
    "inventory:check": "node --max-old-space-size=2048 scripts/inventory.mjs --check",
    "lint": "NODE_OPTIONS=--max-old-space-size=2048 eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "NODE_OPTIONS=--max-old-space-size=2048 vitest run --maxWorkers=1",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=2048 tsc --noEmit",
    "test:dark": "STORYBOOK_APPEARANCE=dark NODE_OPTIONS=--max-old-space-size=2048 vitest run --maxWorkers=1",
    "coverage:inventory": "node --max-old-space-size=2048 scripts/component-coverage.mjs",
    "coverage:check": "node --max-old-space-size=2048 scripts/component-coverage.mjs --check"
  },
  "dependencies": {
    "@iconify/react": "^5.2.1",
    "@repo/access": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/shared-data": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "next": "16.4.1",
    "next-intl": "4.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/strapi-types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^22",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "9.39.2",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "storybook": "10.6.5",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "3.2.6"
  }
}
