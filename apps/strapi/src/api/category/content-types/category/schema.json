{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "A content category shared across wiki and blog articles"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true
      }
    },
    "tagLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "wikiArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::wiki-article.wiki-article",
      "mappedBy": "category",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "blogArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-article.blog-article",
      "mappedBy": "category",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
