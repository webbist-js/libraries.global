      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "pending",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "suggestedByUserId": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "suggestedByEmail": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
