{
  "kind": "collectionType",
  "collectionName": "wiki_articles",
  "info": {
    "singularName": "wiki-article",
    "pluralName": "wiki-articles",
    "displayName": "Wiki Article",
    "description": "A knowledge hub reference article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.image-block",
        "content.code-block",
        "content.quote-block",
        "content.callout"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "section": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::wiki-section.wiki-section",
      "inversedBy": "articles",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "wikiArticles",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "author": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "priority": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::wiki-article.wiki-article",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "articleStatus": {
      "type": "enumeration",
      "enum": [
        "stable",
        "beta",
        "experimental",
        "draft",
        "deprecated"
      ],
      "default": "stable",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contributors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "docsSections": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "libraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "continents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::continent.continent",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "countries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::country.country",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::area.area",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "geographyFacet": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "readingTimeMinutes": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
