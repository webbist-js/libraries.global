{
  "kind": "collectionType",
  "collectionName": "wiki_sections",
  "info": {
    "singularName": "wiki-section",
    "pluralName": "wiki-sections",
    "displayName": "Wiki Section",
    "description": "A top-level section grouping wiki articles"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "icon": {
      "type": "string",
      "description": "Iconify id shown on the Knowledge pages, e.g. mdi:code-tags",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::wiki-article.wiki-article",
      "mappedBy": "section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
