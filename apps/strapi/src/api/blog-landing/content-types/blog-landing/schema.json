{
  "kind": "singleType",
  "collectionName": "blog_landing",
  "info": {
    "singularName": "blog-landing",
    "pluralName": "blog-landings",
    "displayName": "Blog Landing",
    "description": "The editorial blog landing page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroText": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "featuredArticle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::blog-article.blog-article",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sections": {
      "type": "dynamiczone",
      "components": ["sections.editorial-block", "sections.cta-banner", "sections.quick-links"],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
