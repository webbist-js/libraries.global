{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "entityRef": {
      "type": "string",
      "unique": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "shortName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "iso2": {
      "type": "string",
      "unique": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "iso3": {
      "type": "string",
      "unique": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "capitalCity": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "regionTypeLabel": {
      "type": "string",
      "default": "Region",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTagline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "mapConfig": {
      "type": "component",
      "component": "shared.map-config",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "boundaryUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sourceAttribution": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sections": {
      "type": "dynamiczone",
      "components": ["sections.editorial-block", "sections.cta-banner", "sections.quick-links"],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "continent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::continent.continent",
      "inversedBy": "countries",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "regions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::region.region",
      "mappedBy": "country",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "libraries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::library.library",
      "mappedBy": "country",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "nationalLibrary": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library.library",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featuredLibraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
