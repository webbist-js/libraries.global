{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country",
    "description": "Place labels (regionTypeLabel, regionsSectionLabel, areaTypeLabel, areasSectionLabel) are UI labels only and never change the hierarchy."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "entityRef": {
      "type": "string",
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "shortName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "iso2": {
      "type": "string",
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iso3": {
      "type": "string",
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "capitalCity": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "regionTypeLabel": {
      "type": "string",
      "default": "Region",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroTagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "mapConfig": {
      "type": "component",
      "component": "shared.map-config",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sourceAttribution": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "about": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "continent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::continent.continent",
      "inversedBy": "countries",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "regions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::region.region",
      "mappedBy": "country",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "libraries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::library.library",
      "mappedBy": "country",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "nationalLibrary": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library.library",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featuredLibraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "population": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "languages": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "systemDescription": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "budget": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "employees": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "volunteers": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "visitsPerYear": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "regionsSectionLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "areaTypeLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "areasSectionLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "populationCount": {
      "type": "biginteger",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationYear": {
      "type": "integer",
      "min": 1900,
      "max": 2100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationSource": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationSourceUrl": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationLicence": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationRetrievedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationReportingCode": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationMethod": {
      "type": "enumeration",
      "enum": [
        "direct",
        "sum_complete_children"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationCoverage": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "populationEstimates": {
      "type": "json",
      "private": true,
      "description": "Sourced population estimates owned by this place, including year, reporting boundary and import attribution.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
