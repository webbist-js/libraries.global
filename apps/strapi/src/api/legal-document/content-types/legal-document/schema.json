{
  "kind": "collectionType",
  "collectionName": "legal_documents",
  "info": {
    "singularName": "legal-document",
    "pluralName": "legal-documents",
    "displayName": "Legal Document",
    "description": "Terms of use, privacy policy, data licence, cookies — served at /legal/{slug}"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "navLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "lead": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "summaryPoints": {
      "type": "component",
      "component": "legal.summary-point",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sections": {
      "type": "component",
      "component": "legal.section",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "revisions": {
      "type": "component",
      "component": "legal.revision",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
