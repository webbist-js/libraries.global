{
  "kind": "collectionType",
  "collectionName": "library_types",
  "info": {
    "singularName": "library-type",
    "pluralName": "library-types",
    "displayName": "Library Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "summary": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true
      }
    },
    "category": {
      "type": "enumeration",
      "enum": ["Other"],
      "default": "Other"
    }
  }
}
