{
  "kind": "collectionType",
  "collectionName": "blog_articles",
  "info": {
    "singularName": "blog-article",
    "pluralName": "blog-articles",
    "displayName": "Blog Article",
    "description": "An editorial blog post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.image-block",
        "content.code-block",
        "content.quote-block",
        "content.callout"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "section": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-section.blog-section",
      "inversedBy": "articles",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "blogArticles",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "author": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "authorProfile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-profile.user-profile",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-article.blog-article",
      "configurable": true,
      "private": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "authorBio": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "authorAvatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "libraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "contributors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-profile.user-profile",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "continents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::continent.continent",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "countries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::country.country",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::area.area",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "geographyFacet": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "readingTimeMinutes": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "publicationOrigin": {
      "type": "enumeration",
      "enum": ["index", "community"],
      "default": "index",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "eventMentions": {
      "type": "component",
      "repeatable": true,
      "component": "content.event-mention",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "entriesAdded": {
      "type": "integer",
      "min": 0,
      "max": 2147483647,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sources": {
      "type": "component",
      "repeatable": true,
      "component": "content.article-source",
      "max": 30,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
