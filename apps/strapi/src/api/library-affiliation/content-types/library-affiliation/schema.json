{
  "kind": "collectionType",
  "collectionName": "library_affiliations",
  "info": {
    "singularName": "library-affiliation",
    "pluralName": "library-affiliations",
    "displayName": "Library Affiliation"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "baUserId": {
      "type": "string",
      "required": true
    },
    "library": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library.library"
    },
    "role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "verificationMethod": {
      "type": "enumeration",
      "enum": [
        "email_domain",
        "vouching",
        "contact_us",
        "team",
        "network"
      ],
      "default": "contact_us"
    },
    "staffRole": {
      "type": "enumeration",
      "enum": [
        "owner",
        "editor"
      ]
    },
    "canGoLive": {
      "type": "boolean",
      "default": true
    },
    "approvedAt": {
      "type": "datetime"
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "claim",
        "team",
        "network"
      ]
    },
    "teamMember": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::access.team-member"
    },
    "authorityManaged": {
      "type": "boolean",
      "default": false,
      "private": true
    }
  }
}
