      "target": "api::library.library"
    },
    "role": { "type": "string" },
    "department": { "type": "string" },
    "verificationMethod": {
      "type": "enumeration",
      "enum": ["email_domain", "vouching", "contact_us"],
      "default": "contact_us"
    }
  }
}
