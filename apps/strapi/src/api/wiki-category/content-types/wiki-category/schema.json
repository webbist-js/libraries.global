{
  "kind": "collectionType",
  "collectionName": "wiki_categories",
  "info": {
    "singularName": "wiki-category",
    "pluralName": "wiki-categories",
    "displayName": "Wiki Category",
    "description": "A navigable directory section within the knowledge hub"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true
      }
    },
    "tagLabel": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "subTopics": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "order": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::wiki-article.wiki-article",
      "mappedBy": "category",
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
