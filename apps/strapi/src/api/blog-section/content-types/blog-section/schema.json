{
  "kind": "collectionType",
  "collectionName": "blog_sections",
  "info": {
    "singularName": "blog-section",
    "pluralName": "blog-sections",
    "displayName": "Blog Section",
    "description": "A named section / topic grouping for blog articles"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-article.blog-article",
      "mappedBy": "section"
    }
  }
}
