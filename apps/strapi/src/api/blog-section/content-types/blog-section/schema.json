{
  "kind": "collectionType",
  "collectionName": "blog_sections",
  "info": {
    "singularName": "blog-section",
    "pluralName": "blog-sections",
    "displayName": "Blog Section",
    "description": "A named section / topic grouping for blog articles"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tint": {
      "type": "enumeration",
      "enum": [
        "purple",
        "green",
        "blue",
        "rust",
        "neutral"
      ],
      "default": "neutral",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-article.blog-article",
      "mappedBy": "section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
