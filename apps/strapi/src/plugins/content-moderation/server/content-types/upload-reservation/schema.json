{
  "kind": "collectionType",
  "collectionName": "cm_upload_reservations",
  "info": { "singularName": "upload-reservation", "pluralName": "upload-reservations", "displayName": "Upload Reservation" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": false }, "content-type-builder": { "visible": false } },
  "attributes": {
    "reservationId": { "type": "string", "required": true, "unique": true },
    "baUserId": { "type": "string", "required": true, "private": true },
    "quotaDate": { "type": "string", "required": true },
    "bytes": { "type": "integer", "required": true, "min": 1 },
    "status": { "type": "enumeration", "enum": ["reserved", "completed", "cancelled"], "required": true, "default": "reserved" },
    "expiresAt": { "type": "datetime", "required": true },
    "fileId": { "type": "integer" },
    "purpose": { "type": "enumeration", "enum": ["article", "submission", "avatar"], "required": true }
  }
}
