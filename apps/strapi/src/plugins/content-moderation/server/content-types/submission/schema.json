{
  "kind": "collectionType",
  "collectionName": "cm_submissions",
  "info": {
    "singularName": "submission",
    "pluralName": "submissions",
    "displayName": "Submission"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {
    "content-manager": { "visible": true },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "submissionType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "correction",
        "new_library",
        "library_claim",
        "library_edit",
        "wiki_edit",
        "blog_submission",
        "topic_suggestion"
      ]
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "draft",
      "enum": ["draft", "pending", "approved", "rejected", "needs_info"]
    },
    "targetEntityType": {
      "type": "enumeration",
      "enum": [
        "library",
        "country",
        "region",
        "area",
        "wiki_article",
        "blog_article",
        "user_profile",
        "topic"
      ]
    },
    "targetDocumentId": { "type": "string" },
    "targetSlug": { "type": "string" },
    "fields": { "type": "json" },
    "note": { "type": "text" },
    "reviewNote": { "type": "text" },
    "verificationMethod": {
      "type": "enumeration",
      "enum": ["email_domain", "vouching", "contact_us"]
    },
    "submittedByUserId": { "type": "string", "required": true },
    "submittedByEmail": { "type": "string", "required": true },
    "submittedByName": { "type": "string" },
    "reviewedByUserId": { "type": "string" },
    "reviewedAt": { "type": "datetime" },
    "draftData": { "type": "json" },
    "stepCompleted": { "type": "integer", "default": 0 },
    "editSummary": { "type": "string" },
    "evidenceType": {
      "type": "enumeration",
      "enum": [
        "institutional_url",
        "on_site_photo",
        "press_release",
        "personal_communication",
        "my_institutional_affiliation",
        "other"
      ]
    },
    "evidenceUrl": { "type": "string" },
    "reviewerAssignedTo": { "type": "string" },
    "payloadHash": { "type": "string", "private": true },
    "draftRevision": { "type": "integer", "default": 0, "private": true }
  }
}
