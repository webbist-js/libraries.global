{
  "kind": "collectionType",
  "collectionName": "teams",
  "info": {
    "singularName": "team",
    "pluralName": "teams",
    "displayName": "Team",
    "description": "A Team organisation: a free workspace and API account container with organisers and members. Membership never grants library editing, staff tools or paid access; staff tools come from verified staff claims. Edited from the access plugin's Teams page."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "billingAccountId": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "publicServiceApproved": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "lapsed"],
      "default": "active"
    },
    "verifiedAt": {
      "type": "datetime"
    },
    "notes": {
      "type": "text",
      "private": true
    },
    "libraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library"
    },
    "createdByAdmin": {
      "type": "string",
      "private": true
    },
    "primaryNetwork": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library-network.library-network"
    },
    "widgetBranding": {
      "type": "boolean",
      "default": false,
      "private": true
    }
  }
}
