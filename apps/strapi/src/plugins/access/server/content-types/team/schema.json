{
  "kind": "collectionType",
  "collectionName": "teams",
  "info": {
    "singularName": "team",
    "pluralName": "teams",
    "displayName": "Team",
    "description": "A Team organisation: a library service's organiser and members. Active membership gives Pro personally and Team features on the Team's libraries only. Edited from the access plugin's Teams page."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "billingAccountId": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "billingMode": {
      "type": "enumeration",
      "enum": ["sandbox", "live"],
      "private": true
    },
    "billingRevision": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "billingMembership": {
      "type": "json",
      "private": true
    },
    "billingSuspended": {
      "type": "boolean",
      "default": false,
      "private": true
    },
    "billingArchived": {
      "type": "boolean",
      "default": false,
      "private": true
    },
    "pendingSeats": {
      "type": "integer",
      "min": 1
    },
    "publicServiceApproved": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "seats": {
      "type": "integer",
      "default": 5,
      "min": 1
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "lapsed"],
      "default": "active"
    },
    "source": {
      "type": "enumeration",
      "enum": ["admin", "checkout"],
      "default": "admin"
    },
    "verifiedAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "notes": {
      "type": "text",
      "private": true
    },
    "libraries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library.library"
    },
    "createdByAdmin": {
      "type": "string",
      "private": true
    },
    "primaryNetwork": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::library-network.library-network"
    },
    "widgetBranding": {
      "type": "boolean",
      "default": false,
      "private": true
    }
  }
}
