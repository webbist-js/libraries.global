{
  "name": "mobile-libraries",
  "version": "0.1.0",
  "description": "Mobile library live sharing",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "source": "./strapi-server.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist",
    "strapi-server.ts"
  ],
  "scripts": {
    "build": "strapi-plugin build"
  },
  "dependencies": {
    "@repo/access": "workspace:*",
    "@repo/shared-data": "workspace:*"
  },
  "strapi": {
    "kind": "plugin",
    "name": "mobile-libraries",
    "displayName": "Mobile libraries"
  }
}
