{
  "name": "@repo/strapi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "build": "pnpm run build:plugins && strapi build",
    "build:plugins": "pnpm --filter strapi-plugin-discussions build && cd src/plugins/content-moderation && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/rewards && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/events && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/library-staff && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/mobile-libraries && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/access && ../../../node_modules/.bin/strapi-plugin build && cd - && cd src/plugins/beta-invites && ../../../node_modules/.bin/strapi-plugin build && cd - && node scripts/check-plugin-style-runtime.mjs",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "dev": "pnpm run run:db && pnpm run develop",
    "develop": "strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "events:rekey": "tsx scripts/events-rekey.ts",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "generate": "strapi generate",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "ingest": "tsx scripts/ingests/run.ts",
    "postinstall": "pnpm run build:plugins",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix",
    "notifications:check": "tsx scripts/notifications-check.ts",
    "run:db": "docker compose up -d db",
    "search:settings": "tsx scripts/refresh-library-projections.ts --settings-only",
    "seed:meilisearch": "tsx scripts/seed-meilisearch.ts",
    "seed:mobile-stops": "tsx scripts/seed-mobile-stops.ts",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --exclude tests/app.test.ts --maxWorkers=1",
    "test:watch": "vitest",
    "transfer": "strapi transfer",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.admin.json"
  },
  "dependencies": {
    "@_sh/strapi-plugin-ckeditor": "8.0.0",
    "@arshiash80/strapi-plugin-iconhub": "1.1.1",
    "@notum-cz/strapi-plugin-tiptap-editor": "^1.0.1",
    "@repo/access": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/event-providers": "workspace:*",
    "@repo/events-crypto": "workspace:*",
    "@repo/shared-data": "workspace:*",
    "@strapi-community/plugin-seo": "^2.1.1",
    "@strapi/database": "5.60.0",
    "@strapi/design-system": "2.2.4",
    "@strapi/plugin-color-picker": "5.60.0",
    "@strapi/plugin-sentry": "5.60.0",
    "@strapi/plugin-users-permissions": "5.60.0",
    "@strapi/provider-email-mailgun": "5.60.0",
    "@strapi/provider-email-nodemailer": "5.60.0",
    "@strapi/provider-upload-aws-s3": "5.60.0",
    "@strapi/strapi": "5.60.0",
    "@strapi/utils": "5.60.0",
    "axios": "^1.21.0",
    "ckeditor5": "48.5.1",
    "diff": "^9.0.0",
    "free-email-domains": "1.12.13",
    "jsonwebtoken": "9.0.3",
    "lodash": "^4.18.1",
    "passport-google-oauth2": "^0.2.0",
    "pg": "^8.13.1",
    "qs": "^6.17.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-config-sync": "2.1.0",
    "strapi-plugin-discussions": "workspace:*",
    "strapi-plugin-meilisearch": "^0.16.5",
    "strapi-plugin-timezone-select": "2.0.0",
    "styled-components": "^6.0.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@strapi/icons": "2.2.4",
    "@strapi/sdk-plugin": "5.4.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "21.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.6"
  },
  "strapi": {
    "uuid": "@repo/strapi"
  }
}
