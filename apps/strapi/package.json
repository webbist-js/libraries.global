{
  "name": "@repo/strapi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "build": "pnpm run build:plugins && strapi build",
    "build:plugins": "cd src/plugins/content-moderation && pnpm exec strapi-plugin build && cd - && cd src/plugins/topics && pnpm exec strapi-plugin build && cd - && cd src/plugins/rewards && pnpm exec strapi-plugin build && cd - && cd src/plugins/events && pnpm exec strapi-plugin build && cd -",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "dev": "pnpm run run:db && pnpm run develop",
    "develop": "strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "generate": "strapi generate",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "postinstall": "pnpm run build:plugins",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix",
    "run:db": "docker compose up -d db",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "vitest run",
    "test:watch": "vitest",
    "transfer": "strapi transfer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@_sh/strapi-plugin-ckeditor": "^6.0.2",
    "@arshiash80/strapi-plugin-iconhub": "1.1.1",
    "@notum-cz/strapi-plugin-tiptap-editor": "^1.0.1",
    "@repo/catalogues": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/events-crypto": "workspace:*",
    "@repo/shared-data": "workspace:*",
    "@strapi-community/plugin-seo": "^2.1.1",
    "@strapi/database": "5.55.1",
    "@strapi/design-system": "2.2.0",
    "@strapi/plugin-color-picker": "5.55.1",
    "@strapi/plugin-sentry": "5.55.1",
    "@strapi/plugin-users-permissions": "5.55.1",
    "@strapi/provider-email-mailgun": "5.55.1",
    "@strapi/provider-email-nodemailer": "5.55.1",
    "@strapi/strapi": "5.55.1",
    "@strapi/utils": "5.55.1",
    "axios": "^1.16.1",
    "ckeditor5": "45.2.2",
    "diff": "^9.0.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "^4.17.21",
    "nodemailer": "^7.0.12",
    "pg": "^8.13.1",
    "qs": "^6.14.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-config-sync": "2.1.0",
    "strapi-plugin-meilisearch": "^0.16.0",
    "strapi-plugin-timezone-select": "2.0.0",
    "styled-components": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "strapi": {
    "uuid": "@repo/strapi"
  }
}
