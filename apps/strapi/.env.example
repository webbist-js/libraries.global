# Tweak for your needs and rename to .env
# Do not leave empty values, e.g. `DATABASE_PASSWORD=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# ----- Strapi general -----

# The host where Strapi will listen.
HOST=0.0.0.0

# The port where Strapi will listen.
PORT=1337

# Signing secrets. NEVER reuse these placeholders (or any committed value)
# outside local dev. Generate each one with:  openssl rand -base64 16
# The secret keys used to sign the session cookies.
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4

# The secret used to sign the API tokens.
API_TOKEN_SALT=toBeModified

# The secret used to sign the JWT for the Admin panel.
ADMIN_JWT_SECRET=toBeModified

# The secret used to sign the JWT for the Users-Permissions plugin
JWT_SECRET=toBeModified

# The secret used to sign the token for transfer data between 2 Strapi instances.
# TRANSFER_TOKEN_SALT=

# Enable or disable cron jobs. Default: false
# CRON_ENABLED=

# Enable on BOTH Strapi and Next.js to close the platform for beta.
# The shared invitation password and cookie signing secret live only in Next.js.
BETA_GATE_ENABLED=false

# Sets the public URL of the application (usually related to production deploy).
APP_URL=http://localhost:1337
# Public media origins allowed by the admin's image/media Content Security Policy.
# MEDIA_CSP_ORIGINS=https://YOUR_MEDIA_CDN_HOST,https://YOUR_MEDIA_BUCKET_HOST

# The URL of the admin panel. Consumed by frontend of custom strapi plugin.
# STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

# Enable or disable receiving populated relations in webhooks. Default: false
# WEBHOOKS_POPULATE_RELATIONS=

# Trust X-Forwarded-For / -Proto from the reverse proxy (Strapi Cloud, nginx,
# a load balancer). Leave false when Strapi is reachable directly, or clients
# could spoof their address for rate limits. Default: false
# TRUST_PROXY=false

# ----- Database -------

# Full connection string for the database. It has higher priority than the other database connection options.
# DATABASE_URL=

# The database client to use.
DATABASE_CLIENT=postgres

# The database host.
DATABASE_HOST=0.0.0.0

# The database port.
DATABASE_PORT=5432

# The database name.
DATABASE_NAME=strapi-db

# The database username.
DATABASE_USERNAME=admin

# The database password.
DATABASE_PASSWORD=mFm8z7z8

# Enable SSL support.
DATABASE_SSL=false

# Production: mount the provider CA certificate and keep verification enabled.
# DATABASE_SSL_CA_FILE=/run/secrets/database-ca.crt
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=8

# Test database name. Default: .tmp/test.db
# TEST_DATABASE_FILENAME=

# ----- AWS S3 storage -----

# AWS_ACCESS_KEY_ID=

# AWS_ACCESS_SECRET=

# AWS_REGION=
# S3-compatible storage, e.g. DigitalOcean Spaces in London.
# AWS_ENDPOINT=https://lon1.digitaloceanspaces.com
# AWS_FORCE_PATH_STYLE=false

# AWS_BUCKET=

# Set 'private' if you want to make the uploaded files private. Default: 'public-read'.
# AWS_ACL=

# Expiration time of signed url in seconds. Default: 15 * 60.
# AWS_SIGNED_URL_EXPIRES=

# If you're using the bucket as a CDN and deliver the content on a custom domain, you can get use of the baseUrl
# and rootPath properties to configure how your assets' urls will be saved inside Strapi.
# CDN_URL=
# CDN_ROOT_PATH=

# ------- Mailgun -------

# Generic SMTP (e.g. Brevo). Takes priority over Mailgun/Mailtrap when set.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Public postal address for optional email footers.
# EMAIL_POSTAL_ADDRESS=
# EMAIL_FROM="Libraries Global <info@libraries.global>"
# EMAIL_REPLY_TO=info@libraries.global
# External setup: docs/beta-release-setup.md

# MAILGUN_API_KEY=

# MAILGUN_DOMAIN=

# Default: https://api.eu.mailgun.net
# MAILGUN_HOST=

# Default from and reply to address.
# MAILGUN_EMAIL=

# ------- Mailtrap --------

# MAILTRAP_USER=
# MAILTRAP_PASS=
# MAILTRAP_HOST=
# MAILTRAP_PORT=
# MAILTRAP_EMAIL=

# ------- Sentry -------

# SENTRY_DSN=

# ------- Strapi Preview Feature --------

# Base URL of the frontend. Can be used by backend to generate links to frontend.
# Required for Strapi Preview
CLIENT_URL=http://localhost:3000
# Strapi Preview toggle. Values "true" => enabled, else disabled
STRAPI_PREVIEW_ENABLED=true
# Shared secret for frontend and backend that enables draft mode
STRAPI_PREVIEW_SECRET=your-secret-key

# ------- OTHER -------

# Link to the frontend account activation page. It is used in email templates sent by backend.
# CLIENT_ACCOUNT_ACTIVATION_URL=http://localhost:3000/auth/activate

# Setting a token enables injecting of runtime variables into the admin panel (to inject CSS, variables, etc.).
# Use a long, randomly generated secret string (for example: `openssl rand -hex 32`).
# ADMIN_PANEL_CONFIG_API_AUTH_TOKEN=your-secure-random-token-here

# ------- Better Auth -------

# Secret used to sign session tokens. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Shared secret the Next.js app sends as X-Service-Secret on bridge calls
# (session profile, submissions, moderation); must match apps/ui. Unset = every bridge route refuses.
# STRAPI_BRIDGE_SECRET=

# Full base URL for Better Auth endpoints (including /api/better-auth path).
# For local dev: http://localhost:1337/api/better-auth
# For production/ngrok: https://<strapi-domain>/api/better-auth
BETTER_AUTH_BASE_URL=http://localhost:1337/api/better-auth

# Public URL of the Next.js frontend. Used for trustedOrigins, password-reset email links
# and the links in moderation notification emails (/contribute/submissions, /contribute/moderation/<id>).
# For local dev: http://localhost:3000
# For production/ngrok: https://<nextjs-domain>
APP_PUBLIC_URL=http://localhost:3000

# OAuth — GitHub (callback URL must be set to {BETTER_AUTH_BASE_URL}/callback/github in GitHub app settings)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# OAuth — Google (callback URL must be set to {BETTER_AUTH_BASE_URL}/callback/google in Google console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to make credentialed requests
# (CLIENT_URL is always allowed). Set the production app URL here in prod.
CORS_ORIGINS=
# Dev only: allow https://*.ngrok-free.app / *.ngrok.io tunnels. Ignored in production.
ALLOW_NGROK_ORIGINS=false

# ── MCP server ────────────────────────────────────────────────────────────────
# Strapi's built-in MCP server at /mcp, authenticated with admin tokens
# (Settings → Admin tokens). Each token acts with its owner's admin permissions.
MCP_ENABLED=false

# Private operator scripts; each server grants its own content permissions.
# The current operator token value is shared by local and production.
# Set STRAPI_PRODUCTION_MCP_TOKEN if those credentials diverge.
STRAPI_MCP_TOKEN=
STRAPI_PRODUCTION_MCP_TOKEN=
STRAPI_PRODUCTION_URL=http://127.0.0.1:18013

# ── Sync worker ───────────────────────────────────────────────────────────────
# Used only for the worker's /health check from the admin panel.
WORKER_URL=http://localhost:3100

# ── Event feeds ───────────────────────────────────────────────────────────────
# AES-256-GCM key (64-char hex) that seals Event Credential values. Must match
# the sync worker's EVENTS_CREDENTIAL_KEY: both read the same encrypted rows.
# Generate with: openssl rand -hex 32
EVENTS_CREDENTIAL_KEY=<64-char hex string>
# The previous key, kept during a rotation so old values still decrypt. Clear
# it once `pnpm --filter @repo/strapi events:rekey` has re-encrypted everything.
EVENTS_CREDENTIAL_KEY_PREV=

# ── Event feeds — Eventbrite OAuth ───────────────────────────────────────────
# "Connect with Eventbrite" on a library's feed. Without all three, the
# connect button is hidden and the oauth route answers 503.
# EVENTBRITE_CLIENT_ID=
# EVENTBRITE_CLIENT_SECRET=
# EVENTBRITE_REDIRECT_URI=

# ── Moderation notifications ─────────────────────────────────────────────────
# Where new role applications, drive proposals and event feed submissions are
# announced. Emails use the provider above (SMTP, Mailgun or Mailtrap); without one they
# are logged and skipped.
MODERATORS_EMAIL=moderators@libraries.global

# ── Mobile libraries: live sharing ───────────────────────────────────────────
# Emergency off switch for live sharing from the /live console. "false" refuses
# new live writes, ends active sessions (kill_switch) and hides public live
# states; boot logs it loudly. Default: on. See docs/mobile-live.md.
# MOBILE_LIVE_ENABLED=true
# Signs the "Confirm it's you" step-up cookie; must match apps/ui. Unset, both
# apps fall back to STRAPI_BRIDGE_SECRET. Rotate it to expire every confirmation.
# MOBILE_LIVE_STEPUP_SECRET=

# ── Audit trail ──────────────────────────────────────────────────────────────
# Change Records and Article Changes are written for every library and article
# write, inside the write's transaction when it has one. Set to false only in an
# emergency: writes then go unrecorded, and Strapi logs a warning at boot.
# Default: true
# CHANGE_RECORDS_ENABLED=true
## Atlas capture/source API. Heavy work runs in the independent Atlas worker.
ATLAS_ENABLED=false
ATLAS_CANONICAL_LOCALE=en
ATLAS_SERVICE_TOKEN=
# Set false after 100% rollout; prevents accidental full-corpus downloads.
ATLAS_LEGACY_SOURCE_ENABLED=true

# Weekly World Bank population refresh (also requires CRON_ENABLED=true).
POPULATION_SYNC_ENABLED=false

# Email activity inbox and delivery worker (Strapi only)
# EMAIL_LINK_SECRET: openssl rand -hex 32; keep stable for unsubscribe links.
# EMAIL_LINK_SECRET=
# APP_INTERNAL_URL=http://localhost:3000
# CRON_ENABLED=true
# EMAIL_DIGEST_ENABLED=false
# EMAIL_REPORT_ENABLED=false
# EMAIL_SEND_INTERVAL_MS=1000
# Setup and DNS checklist: docs/email-setup.md

# Must match apps/ui: sandbox billing must never grant live access.
BILLING_ENV=sandbox
