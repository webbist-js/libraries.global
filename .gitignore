/.pnpm-store/

# Operator infrastructure is private; generic image build checks live in scripts/release.
/infra/

# Account-specific Stripe setup results are private operator artefacts.
/apps/ui/scripts/*-catalogue.json

# Local design audit logs.
/.motion-site/log.json

# Local agent context; public guidance lives in AGENTS.md and apps/docs/docs/.
/.claude/context/

